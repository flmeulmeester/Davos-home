```{r}
# 5. Create questionnaire completion indicators
# 1: a questionnaire date is recorded.
# 0: no questionnaire date is recorded.

# Baseline questionnaire completion indicator
data_STARTQ_wide <- data_STARTQ_wide %>%
  mutate(
    START_yes = ifelse(!is.na(STR_datequest2_t0), 1, 0),
    .after = patid
  )

# Helper function to create questionnaire completion indicators
add_yes_indicators <- function(df, prefix, timepoints = c("t12","t9","t6","t3","t0")) {
  for(tp in timepoints) {
    datevar <- paste0(prefix, "_datequest2_", tp)
    yesvar  <- paste0(prefix, "_", tp, "_yes")
    if(datevar %in% colnames(df)) {
      df[[yesvar]] <- ifelse(!is.na(df[[datevar]]), 1, 0)
      df <- df %>% relocate(all_of(yesvar), .after = patid)
    }
  }
  return(df)
}

# Apply the helper function to each questionnaire dataset
data_ACQ6_wide <- add_yes_indicators(data_ACQ6_wide, "ACQ")
data_AQLQ_wide <- add_yes_indicators(data_AQLQ_wide, "mAQLQ")
data_CISF_wide <- add_yes_indicators(data_CISF_wide, "CISF")
data_HADS_wide <- add_yes_indicators(data_HADS_wide, "HADS")
data_SNOT_wide <- add_yes_indicators(data_SNOT_wide, "SNOT")
data_HCU_wide <- add_yes_indicators(data_HCU_wide, "HCU")
data_preWPAI_wide <- add_yes_indicators(data_preWPAI_wide, "H12")

