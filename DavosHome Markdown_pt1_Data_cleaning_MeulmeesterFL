# Difference in days between questionnaires

```{r}
# Make sure var datequest2 (for the date) is in the correct date format
# Use datequest2 from Alchemer, as this reflects the recorded questionnaire
# date, including cases where a patient selected 'other date'

data$datequest2 <- format(data$datequest2, "%Y-%m-%d") # Format as DD-MM-YYYY
```


```{r}
# Calculate the number of days since the previous questionnaire
# Differences are calculated separately for each participant and questionnaire
# type. The first questionnaire in each group has no previous date, so days_diff
# is set to NA.
data <- data %>%
  group_by(patid, type) %>%  # Group by both patid AND type
  mutate(days_diff = if_else(
    !is.na(lag(datequest2)),
    as.numeric(difftime(datequest2, lag(datequest2), units = "days")),
    NA_real_
  ), .after = datequest2) %>%
  ungroup() %>%
  arrange(patid, datequest2)  # Re-sort to maintain chronological order = datequest2)

```




