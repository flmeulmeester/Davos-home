# Participant-level time-to-event summary

```{r}
# Create a participant-level dataset with one row per participant.
#
# exa_n: total number of exacerbations during follow-up.
# arm: randomised study group.
# time: week of the first exacerbation for participants with an event;
#       otherwise, the last recorded follow-up week.
#
# This dataset forms the basis for time-to-first-event analyses.

data_summary_EXAC <- data_EXAC %>%
  group_by(patid) %>%
  summarise(
    exa_n = if (all(is.na(total_n_exa))) {
      NA
    } else {
      first(na.omit(total_n_exa))
    },
    arm = if (all(is.na(arm))) {
      NA
    } else {
      first(na.omit(arm))
    },
    time = if (all(is.na(first_exa_fu_week))) {
      max(fu_week, na.rm = TRUE)
    } else {
      first(na.omit(first_exa_fu_week))
    },
    .groups = "drop"
  )

# Define event status for time-to-event analyses.
# status = 1: at least one exacerbation was recorded.
# status = 0: no exacerbation was recorded during follow-up.

data_summary_EXAC <- data_summary_EXAC %>%
  mutate(status = ifelse(exa_n > 0, 1, 0))
