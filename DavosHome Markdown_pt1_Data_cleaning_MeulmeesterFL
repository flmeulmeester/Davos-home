```{r}
# STEP 1: Exacerbation classification based on oral corticosteroid use
# without an increase above maintenance treatment
#
# Define binary indicators for corticosteroid use lasting at least
# 3 days within a week or across consecutive questionnaires.
#
# Coding:
# 0 = criterion not met
# 1 = criterion met
#
# The classification is performed separately for each follow-up period.
# Maintenance corticosteroid use is accounted for using the maintenance
# dose information available for the corresponding period.

# Baseline period
data_EXAC <- data_EXAC %>%
  mutate(
    pred_use_3days_0months =
      case_when(
        EXAC_month == "0 months" & !is.na(STRpred_main_mgN) ~ 0,
        EXAC_month == "0 months" & EXAtotal_days_pred_weekly >= 3 ~ 1,
        EXAC_month == "0 months" & patid == lag(patid) &
          days_diff <= 13 &
          (lag(EXAtotal_days_pred_weekly, default = 0) +
             EXAtotal_days_pred_weekly) >= 3 ~ 1,
        EXAC_month == "0 months" & patid == lead(patid) &
          days_diff <= 13 &
          (lead(EXAtotal_days_pred_weekly, default = 0) +
             EXAtotal_days_pred_weekly) >= 3 ~ 1,
        TRUE ~ 0
      )
  )

table(data_EXAC$pred_use_3days_0months)

# 3-month follow-up
