# Identify the date of the first recorded exacerbation for each participant.
# Participants without a recorded exacerbation retain a missing value.

data_EXAC <- data_EXAC %>%
  group_by(patid) %>%
  mutate(
    date_first_exa = ifelse(
      !all(is.na(date_exa)) &
        date_exa == min(date_exa, na.rm = TRUE),
      date_exa,
      NA
    )
  ) %>%
  ungroup()
