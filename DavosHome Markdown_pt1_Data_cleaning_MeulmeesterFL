```{r}
# Quality checks for prolonged sequences of positive records
#
# Identify participants with at least five consecutive positive records
# for either corticosteroid-use indicator. These sequences may represent
# prolonged treatment or multiple records belonging to the same episode
# and should be reviewed during data validation.

# Function to detect runs of five or more consecutive values equal to 1.
has_consec_5 <- function(x) {
  r <- rle(x)
  any(r$values == 1 & r$lengths >= 5)
}

# Identify participants with prolonged sequences of positive records
# for the corticosteroid-use indicator without an increase above
# maintenance treatment.

patids_with_5_consec_burst <- data_EXAC %>%
  group_by(patid) %>%
  summarise(
    has_run = has_consec_5(pred_use_3days_all),
    .groups = "drop"
  ) %>%
  filter(has_run) %>%
  pull(patid)

# Identify participants with prolonged sequences of positive records
# for the increased-maintenance-dose indicator.

patids_with_5_consec_maintenance <- data_EXAC %>%
  group_by(patid) %>%
  summarise(
    has_run = has_consec_5(pred_higher_3days),
    .groups = "drop"
  ) %>%
  filter(has_run) %>%
  pull(patid)
